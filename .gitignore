/target/
# Nested target dirs for excluded/standalone packages (wasm demo, fuzz harnesses).
**/target/
**/*.rs.bk
*.pdb

.vscode/
.idea/
*.swp

.DS_Store
Thumbs.db

# Stray build/test logs
*.log

# cargo-fuzz outputs
**/corpus/
**/artifacts/

# wasm-bindgen / wasm-pack output
**/pkg/

# Python bindings (pyo3 + maturin) build/venv artifacts
**/.pytest_cache/
**/.venv/
**/__pycache__/
**/*.pyc
# Cargo.lock is tracked: the CLI and Python extension ship binaries and need reproducible builds.

# Built Python extensions (maturin develop writes these into the source tree)
*.pyd

# Staged GitHub Pages site for the browser playground (built by .github/workflows/pages.yml)
**/site/
