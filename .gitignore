/target/
# Nested target dirs for excluded/standalone packages (wasm demo, fuzz harnesses).
**/target/
**/*.rs.bk
*.pdb
Cargo.lock

.vscode/
.idea/
*.swp

.DS_Store
Thumbs.db

# Stray build/test logs
*.log

# cargo-fuzz outputs
**/corpus/
**/artifacts/

# wasm-bindgen / wasm-pack output
**/pkg/

# Python bindings (pyo3 + maturin) build/venv artifacts
**/.pytest_cache/
**/.venv/
**/__pycache__/
**/*.pyc
# Keep the bindings crate's Cargo.lock (application-style, reproducible wheels).
